    origin_case("HTTP://10.0.0.1/", "http://10.0.0.1");
    origin_case("ssh://h.:21/a/b", "null");
    origin_case("http://u:p@h.:0#f", "http://h.:0");
    origin_case("wss://u:p@a.b.c:8443/a/b", "wss://a.b.c:8443");
    origin_case("ftp://u@localhost", "ftp://localhost");
    origin_case("wss://a.b.c:21/a/b", "wss://a.b.c:21");
    origin_case("ssh://[2001:db8::1]/a?x=1#f", "null");
    origin_case("https://u@h./a?x=1#f", "https://h.");
    origin_case("ssh://EXAMPLE.com:21", "null");
    origin_case("ftp://a.b.c/a?x=1#f", "ftp://a.b.c");
    origin_case("data:text/plain,x", "null");
    origin_case("mailto:a@b.c", "null");
    origin_case("urn:isbn:1", "null");
}
