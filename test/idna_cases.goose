    bad += check_set(1, "foo://h:80/p", "u", "foo://u@h:80/p", "foo://h:80/p");
    bad += check_set(5, "http://[::1]/a", "../x", "http://[::1]/x", "http://[::1]/a");
    bad += check_set(5, "foo://h", "%41", "foo://h/%41", "foo://h");
    bad += check_set(5, "foo://h", "", "foo://h", "foo://h");
    bad += check_set(0, "foo://h", "ftp:", "foo://h", "foo://h");
    bad += check_set(6, "foo://h", "", "foo://h", "foo://h");
    bad += check_set(0, "foo://u@h/x", "ftp:", "foo://u@h/x", "foo://u@h/x");
    bad += check_set(5, "foo:/a/b", "", "foo:/", "foo:/a/b");
    bad += check_set(1, "http://u:p@Example.com:8080/a/b?q=1#f", "%41", "http://%41:p@example.com:8080/a/b?q=1#f", "http://u:p@example.com:8080/a/b?q=1#f");
    bad += check_set(5, "https://h/", "a?b#c", "https://h/a%3Fb%23c", "https://h/");
    bad += check_set(3, "mailto:x@y", "1.2.3.4", "mailto:x@y", "mailto:x@y");
    bad += check_set(4, "http://[::1]/a", "80", "http://[::1]/a", "http://[::1]/a");
    bad += check_set(1, "https://h/", "", "https://h/", "https://h/");
    bad += check_set(3, "ws://h", "localhost", "ws://localhost/", "ws://h/");
    bad += check_set(5, "foo:opaque", "//x", "foo:opaque", "foo:opaque");
    bad += check_set(3, "foo://u@h/x", "a:80", "foo://u@h/x", "foo://u@h/x");
    bad += check_set(5, "http://u:p@Example.com:8080/a/b?q=1#f", "a", "http://u:p@example.com:8080/a?q=1#f", "http://u:p@example.com:8080/a/b?q=1#f");
    bad += check_set(0, "ws://h", "FILE", "file://h/", "ws://h/");
    bad += check_set(4, "mailto:x@y", "", "mailto:x@y", "mailto:x@y");
    bad += check_set(2, "file://host/x", "%41", "file://host/x", "file://host/x");
    bad += check_set(5, "mailto:x@y", "a?b#c", "mailto:x@y", "mailto:x@y");
    bad += check_set(3, "foo:opaque", "x/y", "foo:opaque", "foo:opaque");
    bad += check_set(5, "foo:opaque", "/a/b", "foo:opaque", "foo:opaque");
    bad += check_set(3, "http://[::1]/a", "x/y", "http://x/a", "http://[::1]/a");
    bad += check_set(5, "file://host/x", ".", "file://host/", "file://host/x");
    bad += check_set(1, "file:///c:/x", "\xc3\xa9", "file:///c:/x", "file:///c:/x");
    bad += check_set(2, "foo:/a/b", "a b", "foo:/a/b", "foo:/a/b");
    bad += check_set(5, "foo:/a/b", "\xc3\xa9", "foo:/%C3%A9", "foo:/a/b");
    bad += check_set(3, "https://h/", "x/y", "https://x/", "https://h/");
    bad += check_set(2, "ws://h", "a#b", "ws://:a%23b@h/", "ws://h/");
    bad += check_set(7, "https://h/", "a`b", "https://h/#a%60b", "https://h/");
    bad += check_set(5, "mailto:x@y", ".", "mailto:x@y", "mailto:x@y");
    bad += check_set(3, "ws://h", "", "ws://h/", "ws://h/");
    bad += check_set(4, "foo://u@h/x", "00080", "foo://u@h:80/x", "foo://u@h/x");
    bad += check_set(3, "foo://h", "h", "foo://h", "foo://h");
    bad += check_set(0, "ws://h", "HTTP:", "http://h/", "ws://h/");
    bad += check_set(0, "file:///c:/x", "file", "file:///c:/x", "file:///c:/x");
    bad += check_set(3, "foo:opaque", "a b", "foo:opaque", "foo:opaque");
    bad += check_set(5, "ws://h", "a b", "ws://h/a%20b", "ws://h/");
    bad += check_set(6, "foo://h", "?a=1&b=2", "foo://h?a=1&b=2", "foo://h");
    bad += check_set(3, "foo:opaque", "h", "foo:opaque", "foo:opaque");
    bad += check_set(3, "foo:/a/b", "a.b?z", "foo://a.b/a/b", "foo:/a/b");
    bad += check_set(3, "ftp://h:21/", "\xc3\xa9", "ftp://xn--9ca/", "ftp://h/");
    bad += check_set(3, "file:///c:/x", "a b", "file:///c:/x", "file:///c:/x");
    bad += check_set(0, "file:///c:/x", "FILE", "file:///c:/x", "file:///c:/x");
    bad += check_set(4, "ftp://h:21/", " 80", "ftp://h/", "ftp://h/");
    bad += check_set(4, "ws://h", "65536", "ws://h/", "ws://h/");
    bad += check_set(3, "https://h/", "1.2.3.4", "https://1.2.3.4/", "https://h/");
    bad += check_set(1, "foo:opaque", "\xc3\xa9", "foo:opaque", "foo:opaque");
    bad += check_set(1, "ftp://h:21/", "a b", "ftp://a%20b@h/", "ftp://h/");
    bad += check_set(3, "ws://h", "a:80", "ws://h/", "ws://h/");
    bad += check_set(3, "foo://u@h/x", "a\x5cb", "foo://u@h/x", "foo://u@h/x");
    bad += check_set(4, "http://u:p@Example.com:8080/a/b?q=1#f", "21", "http://u:p@example.com:21/a/b?q=1#f", "http://u:p@example.com:8080/a/b?q=1#f");
    bad += check_set(7, "http://[::1]/a", "\xc3\xa9", "http://[::1]/a#%C3%A9", "http://[::1]/a");
    bad += check_set(0, "https://h/", "1a", "https://h/", "https://h/");
    bad += check_set(5, "ftp://h:21/", "%41", "ftp://h/%41", "ftp://h/");
    bad += check_set(5, "foo:/a/b", "../x", "foo:/x", "foo:/a/b");
    bad += check_set(3, "ws://h", "H.COM", "ws://h.com/", "ws://h/");
    bad += check_set(4, "http://u:p@Example.com:8080/a/b?q=1#f", " 80", "http://u:p@example.com:8080/a/b?q=1#f", "http://u:p@example.com:8080/a/b?q=1#f");
    bad += check_set(5, "mailto:x@y", "%41", "mailto:x@y", "mailto:x@y");
    bad += check_set(2, "ftp://h:21/", "a\x5cb", "ftp://:a%5Cb@h/", "ftp://h/");
    bad += check_set(0, "ws://h", "ftp:", "ftp://h/", "ws://h/");
    bad += check_set(3, "foo:opaque", "a:80", "foo:opaque", "foo:opaque");
    bad += check_set(5, "http://u:p@Example.com:8080/a/b?q=1#f", "//x", "http://u:p@example.com:8080//x?q=1#f", "http://u:p@example.com:8080/a/b?q=1#f");
    bad += check_set(1, "ws://h", "u:v", "ws://u%3Av@h/", "ws://h/");
    bad += check_set(5, "foo://h", "a b", "foo://h/a%20b", "foo://h");
    bad += check_set(3, "file://host/x", "[::1]", "file://[::1]/x", "file://host/x");
    bad += check_set(5, "http://[::1]/a", "/..//x", "http://[::1]//x", "http://[::1]/a");
    bad += check_set(4, "http://[::1]/a", "0", "http://[::1]:0/a", "http://[::1]/a");
    bad += check_set(2, "ws://h", "a@b", "ws://:a%40b@h/", "ws://h/");
    bad += check_set(4, "ws://h", "443", "ws://h:443/", "ws://h/");
    bad += check_set(0, "mailto:x@y", "file", "mailto:x@y", "mailto:x@y");
    bad += check_set(2, "foo:opaque", "a?b", "foo:opaque", "foo:opaque");
    bad += check_set(4, "file://host/x", "-1", "file://host/x", "file://host/x");
    bad += check_set(3, "foo:/a/b", "x/y", "foo://x/a/b", "foo:/a/b");
    bad += check_set(3, "foo://h:80/p", "xn--tda", "foo://xn--tda:80/p", "foo://h:80/p");
    bad += check_set(1, "foo:opaque", "a b", "foo:opaque", "foo:opaque");
    bad += check_set(3, "https://h/", "localhost", "https://localhost/", "https://h/");
    bad += check_set(2, "file:///c:/x", "x/y", "file:///c:/x", "file:///c:/x");
    bad += check_set(2, "ftp://h:21/", "a#b", "ftp://:a%23b@h/", "ftp://h/");
    bad += check_set(4, "https://h/", "-1", "https://h/", "https://h/");
    bad += check_set(1, "foo://h", "\xc3\xa9", "foo://%C3%A9@h", "foo://h");
    bad += check_set(3, "file://host/x", "", "file:///x", "file://host/x");
    assert(bad == 0);
}
