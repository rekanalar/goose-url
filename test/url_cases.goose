// Cases made by test/make_url_cases.mjs with Node v22.22.1.
// Do not edit by hand. Make the file again with the script.

namespace url_cases;

import std;
import url from "..";

fn query_case(qs: const u8[:], key: const u8[:], val: const u8[:], has: bool, has_pair: bool,
        all: const u8[:], set_text: const u8[:], set_n: i64, del_text: const u8[:], del_n: i64,
        dp_text: const u8[:], dp_n: i64, sort_text: const u8[:], sort_n: i64) {
    assert(url::query_has(qs, key) == has);
    assert(url::query_has_pair(qs, key, val) == has_pair);
    var ps: url::Pair[>..] = [];
    assert(url::query_get_all(ps, qs, key));
    var joined: u8[>..] = [];
    for p, i in ps {
        if i > 0 { joined.push('|'); }
        joined.append(p.value);
    }
    assert(joined[..] == all);
    var o: u8[>..] = [];
    assert(url::query_set(o, qs, key, val) == set_n);
    assert(o[..] == set_text);
    o = [];
    assert(url::query_delete(o, qs, key) == del_n);
    assert(o[..] == del_text);
    o = [];
    assert(url::query_delete_pair(o, qs, key, val) == dp_n);
    assert(o[..] == dp_text);
    o = [];
    assert(url::query_sort(o, qs) == sort_n);
    assert(o[..] == sort_text);
}

fn origin_case(text: const u8[:], want: const u8[:]) {
    let u, ok = url::parse(text);
    assert(ok);
    var o: u8[>..] = [];
    let got = url::origin(o, u);
    if want == "null" {
        assert(!got);
        assert(o.len == 0);
    } else {
        assert(got);
        assert(o[..] == want);
    }
}

