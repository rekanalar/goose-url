    query_case("%zz=%ED%A0%80&a=a%26b&%z=2", "é", "%C3", false, false, "", "%25zz=%EF%BF%BD%EF%BF%BD%EF%BF%BD&a=a%26b&%25z=2&%C3%A9=%25C3", 0, "%25zz=%EF%BF%BD%EF%BF%BD%EF%BF%BD&a=a%26b&%25z=2", 0, "%25zz=%EF%BF%BD%EF%BF%BD%EF%BF%BD&a=a%26b&%25z=2", 0, "%25z=2&%25zz=%EF%BF%BD%EF%BF%BD%EF%BF%BD&a=a%26b", 3);
}

fn check_origins() {
    origin_case("blob:https://example.com/uuid", "https://example.com");
    origin_case("blob:http://example.com:8080/uuid", "http://example.com:8080");
    origin_case("blob:https://example.com:8443/u", "https://example.com:8443");
    origin_case("blob:data:text/plain,x", "null");
    origin_case("blob:not a url", "null");
    origin_case("blob:", "null");
    origin_case("blob:file:///a/b", "null");
    origin_case("blob:mailto:a@b.c", "null");
    origin_case("blob:blob:https://example.com/u", "null");
    origin_case("http://evil.com\\@good.com/", "http://evil.com");
    origin_case("http://evil.com\\.good.com/", "http://evil.com");
    origin_case("http://u\\v@example.com/", "http://u");
    origin_case("http://a\\b/", "http://a");
    origin_case("http://a\\b:8080/", "http://a");
    origin_case("http://ex\\ample.com/", "http://ex");
    origin_case("http://exämple.com/", "http://xn--exmple-cua.com");
    origin_case("http://EXÄMPLE.com/", "http://xn--exmple-cua.com");
    origin_case("http://xn--exmple-cua.com/", "http://xn--exmple-cua.com");
    origin_case("http://ex%c3%a4mple.com/", "http://xn--exmple-cua.com");
    origin_case("http://%41.com/", "http://a.com");
    origin_case("http://a..b/", "http://a..b");
    origin_case("http://a_b/", "http://a_b");
    origin_case("http://[::1]/", "http://[::1]");
    origin_case("http://[::1]:8080/", "http://[::1]:8080");
    origin_case("http://u:p@[::1]/", "http://[::1]");
    origin_case("http://u@[2001:db8::1]/", "http://[2001:db8::1]");
    origin_case("https://example.com/", "https://example.com");
    origin_case("https://example.com:443/", "https://example.com");
    origin_case("http://example.com:80/", "http://example.com");
    origin_case("ftp://example.com/", "ftp://example.com");
    origin_case("ws://example.com/", "ws://example.com");
    origin_case("wss://example.com/", "wss://example.com");
    origin_case("http://EXAMPLE.com/", "http://example.com");
    origin_case("http://example.com./", "http://example.com.");
    origin_case("http://example.com:0/", "http://example.com:0");
    origin_case("mailto:a@b.c", "null");
    origin_case("data:text/plain,x", "null");
}
