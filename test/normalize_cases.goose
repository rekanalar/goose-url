namespace normalize_cases;

import std;
import url from "..";

// expect_ok checks that normalize gives want for s.
fn expect_ok(s: const u8[:], want: const u8[:]) {
    var got: u8[>..] = [];
    if !url::normalize(got, s) || got != want {
        print("normalize ok-case failed. input: ", s);
        print("  want: ", want, "  got: ", got);
        assert(false);
    }
}

// expect_no checks that normalize refuses s.
fn expect_no(s: const u8[:]) {
    var got: u8[>..] = [];
    if url::normalize(got, s) {
        print("normalize no-case failed. input: ", s, " gave: ", got);
        assert(false);
    }
}

