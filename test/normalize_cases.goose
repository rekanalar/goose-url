    expect_ok("https:\x5c\x5c:p@1.02.3.4:0/x/%2e.?a<b#", "https://:p@1.2.3.4:0/?a%3Cb#");
    expect_ok("ws:\x5c\x5c1.0x2.3.4:65535/x/#%", "ws://1.2.3.4:65535/x/#%");
    expect_ok("wss:///.//x`y?%41", "wss://.//x%60y?%41");
    expect_ok("wss:\x5c\x5ca`b@a'b:65534/a/b/../../c?a^b#%41", "wss://a%60b@a'b:65534/c?a^b#%41");
    expect_ok("ws:\x5cu:p:q@%41.com/?%41#a`b", "ws://u:p%3Aq@a.com/?%41#a%60b");
    expect_no("https://[::ffff:1.2.3.4]:65536/%2e%2e%2e/x?%");
    expect_ok("wss:////a`b@a.b.c:21/x#y?a=b&c=d#a{b}", "wss://a%60b@a.b.c:21/x#y?a=b&c=d#a{b}");
    expect_no("ftp://0:0x50/a/./b/../c/./d?a`b#");
    expect_no("https:\x5c\x5c08/x#");
    expect_ok("ftp:EXAMPLE.com:80/x<y?%41#a\x22b", "ftp://example.com:80/x%3Cy?%41#a%22b");
    expect_no("ws:////1.02.3.4:99999999999/x\x22y?a|b#a`b");
    expect_ok("https://///%2e/x/?a=1#a\x22b", "https://./x/?a=1#a%22b");
    expect_ok("ws:/u@a_b.c_d:0/../x?a\x22b#a`b", "ws://u@a_b.c_d:0/x?a%22b#a%60b");
    expect_no("http://u%40s:p%40s@a%2Eb:0x50/x/..?a{b#%");
    expect_no("ftp:u%20v@.:a/x{y}z?a\x22b#a`b");
    expect_ok("http:\x5c\x5ca'b@0777a$b:443/%41?a`b", "http://a'b@0777a$b:443/%41?a`b");
    expect_ok("ws://@example.com:65534/x#y?#a^b", "ws://example.com:65534/x#y?#a^b");
    expect_ok("https:[0:0:1:0:0:0:0:1]:80/x/?a^b#a\x22b", "https://[0:0:1::1]:80/x/?a^b#a%22b");
    expect_ok("wss:////a~b@a$b:0/x\x22y#a\x22b", "wss://a~b@a$b:0/x%22y#a%22b");
    expect_ok("https:\x5c\x5c[::1.2.3.4]:65535?", "https://[::102:304]:65535/?");
    expect_no("https:\x5c\x5c[1:2:3:4:5:6:7]:65536//?%41#a<b");
    expect_no("wss://a:b@c@4294967295:65536/x/%2e.?");
    expect_ok("https:///x/../x/?a|b#a<b", "https://x/x/?a|b#a%3Cb");
    expect_ok("ws:/[1:2:3:4:5:6:7:8]:080/%2e%2e/x?a<b#%", "ws://[1:2:3:4:5:6:7:8]/x?a%3Cb#%");
    expect_no("ws:/a]b@EXAMPLE.com:99999999999/a/b/../../c?a{b#%41");
    expect_no("HTTP://a%b@a!b:0x50/./?a|b#a`b");
    expect_ok("http:////999:443/%2e%2e%2e/x?a b#a^b", "http://0.0.3.231:443/%2e%2e%2e/x?a%20b#a^b");
    expect_no("ws://u:p@XN--A.COM:99999999999/%2e%2e/x?a b#");
    expect_ok("ftp:\x5ca~b@0a$b:0/x%20y?a|b", "ftp://a~b@0a$b:0/x%20y?a|b");
    expect_ok("wss:////[FE80::1]:80/x/..?a=1", "wss://[fe80::1]:80/?a=1");
    expect_no("wss::@08:-1/x\x22y?a{b#%41");
    expect_ok("ws:/a\x22b@a,b:65535/x<y?#a{b}", "ws://a%22b@a,b:65535/x%3Cy?#a{b}");
    expect_no("https:/[0:0:1:0:0:0:0:1]:-1/x?a<b#a b");
    expect_no("ws:\x5c[FE80::1]:99999999999/%2e%2e/x?a|b#a|b");
    expect_no("ftp:////:@example.com:0x50/x/?%#");
    expect_no("https://///?a`b#");
    expect_ok("http:a;b@1.2.3:0/x?a^b#%", "http://a%3Bb@1.2.0.3:0/x?a^b#%");
    expect_no("ftp:\x5ca%2Eb:+80/x\x22y?a|b#a<b");
    expect_no("wss://a<b@a-b:a/x%y#a`b");
    expect_no("HTTP://09:65536/a//b?a|b#a{b}");
    expect_ok("HTTP://999:443/x/./y?%41#a{b}", "http://0.0.3.231:443/x/y?%41#a{b}");
    expect_no("ftp:/[1::2::3]:080/x/?%");
    expect_no("https:/0x10:a/a//b?a b#a\x22b");
    expect_no("http://a=b@a'b1.2.3.4.5:99999999999/x/../y?a=b&c=d");
    expect_ok("ftp:\x5ca b@0777a~b:65534/x^y?a<b", "ftp://a%20b@0777a~b:65534/x%5Ey?a%3Cb");
    expect_no("ftp:\x5ca\x22b@09:0x50/x|y?a`b#a\x22b");
    expect_ok("ftp:0x7f.1:443?a=1#", "ftp://127.0.0.1:443/?a=1#");
    expect_ok("https:/a`b@a$b:65535/x%y?a^b#a|b", "https://a%60b@a$b:65535/x%y?a^b#a|b");
    expect_no("wss:\x5c\x5ca%2Fb/%2e%2e%2e/x?%41#a^b");
    expect_ok("ws:////[0:0:1:0:0:0:0:1]:65534/../x?a<b#a`b", "ws://[0:0:1::1]:65534/x?a%3Cb#a%60b");
    expect_ok("https:\x5c\x5ca=b@a_b/...?%#a b", "https://a%3Db@a_b/...?%#a%20b");
    expect_no("https:[::ffff:00.2.3.4]:99999999999/a//b?a=1#a|b");
    expect_no("wss:/u:p:q@a$ba%2Fb/x%y?a{b");
    expect_ok("ws:\x5c[::ffff:0.2.3.4]:080/x{y}z#", "ws://[::ffff:2:304]/x%7By%7Dz#");
    expect_no("https://@1.2.3.4..:a/a b/c d?%#a\x22b");
    expect_ok("ws://1.2.3:443//?%#%41", "ws://1.2.0.3:443//?%#%41");
    expect_no("http:a=b@0:65536/x`y?a b#%41");
    expect_no("ws://0777:a/x/?a\x22b#%41");
    expect_ok("https:u:p:q@127.1:65535/a b/c d#a`b", "https://u:p%3Aq@127.0.0.1:65535/a%20b/c%20d#a%60b");
    expect_ok("wss:a:b@c@a~b:65534/x/../y?a<b#a\x22b", "wss://a:b%40c@a~b:65534/y?a%3Cb#a%22b");
    expect_ok("wss:\x5c@0177.0.0.1:65535/a/b/../../c?a=1", "wss://127.0.0.1:65535/c?a=1");
    expect_ok("ftp:/x/../y/x`y?a'b#%", "ftp://x/y/x%60y?a%27b#%");
    expect_no("wss:/a%b@0:a/x y?a{b#a`b");
    expect_no("wss:a|b@999:99999999999/...?a'b#a b");
    expect_ok("wss:\x5c\x5c/x/../y/x?a=1#%", "wss://x/y/x?a=1#%");
    expect_no("https:@1.2.3.4.5:65534/x y?a\x5cb#");
    expect_ok("ftp:/a b@.//?%41#a\x22b", "ftp://a%20b@.//?%41#a%22b");
    expect_ok("http:/..././?a=b&c=d", "http://.../?a=b&c=d");
    expect_no("wss:a[b@00:a/a/./b/../c/./d?a{b");
    expect_no("wss:[1:2:3:4:5:6:7::]:0x50?%41#x");
    expect_no("ftp:a'b@1.2.3.4.54294967295:a/a/./b/../c/./d");
    expect_ok("https://a~b@a&b:080/%2e%2e/x?a'b#a{b}", "https://a~b@a&b:80/x?a%27b#a{b}");
    expect_ok("wss:/x/y/../x?a{b#a|b", "wss://x/x?a{b#a|b");
    expect_no("wss://a^b@a,b:65536?%#%41");
    expect_no("https:\x5c\x5ca b@1.2.3:+80/x^y?a\x22b#a<b");
    expect_ok("WS://[::1.2.3.4]:80/x^y?a`b#a^b", "ws://[::102:304]/x%5Ey?a`b#a^b");
    expect_no("https:\x5c/x y/x/y?a\x22b#a|b");
    expect_ok("https:\x5c\x5c[::ffff:0.2.3.4]:65534/../x?a<b#a^b", "https://[::ffff:2:304]:65534/x?a%3Cb#a^b");
    expect_no("https:\x5c\x5ca^b@1.02.3.4:65536/x\x22y#a|b");
    expect_no("http:a[b@a'b:99999999999/x/y?%41#a|b");
    expect_ok("https://1.2.3.4.:443/%2e/x?a<b#", "https://1.2.3.4/x?a%3Cb#");
    expect_ok("WSS://u:p@a~b:080/../x?a'b#a`b", "wss://u:p@a~b:80/x?a%27b#a%60b");
    expect_ok("wss://a'b@a_b.c_d0777:65535/../x?a\x5cb", "wss://a'b@a_b.c_d0777:65535/x?a\x5cb");
    expect_no("wss:\x5c:@1.2.3.4999:0x50/x/..?%41");
    expect_ok("wss:a~b@1.2.3.4..:21/x{y}z?a'b#a<b", "wss://a~b@1.2.3.4..:21/x%7By%7Dz?a%27b#a%3Cb");
    expect_no("ftp:0x7f.1:65536/x#y?%#a b");
    expect_ok("ftp:////[::ffff:0.2.3.4]:21/%41?a=b&c=d", "ftp://[::ffff:2:304]/%41?a=b&c=d");
    expect_no("ftp://[12345::]:21/%2e/x?a{b");
    expect_no("http:/[12345::]:+80/x|y?#");
    expect_no("ftp:////a~b@.:0x50/../x?a<b#");
    expect_no("http:/a<b@1.2.3.4:99999999999/x|y?a\x22b#a<b");
    expect_ok("HTTPS://1.2.3:21/%2e%2e%2e/x?a b#a<b", "https://1.2.0.3:21/%2e%2e%2e/x?a%20b#a%3Cb");
    expect_no("ftp:/:@1.2.3.4.5:65535/x%20y?a\x22b#a\x22b");
    expect_ok("ftp://u%20v@0:080/...?a=1#a|b", "ftp://u%20v@0.0.0.0:80/...?a=1#a|b");
    expect_no("ws:\x5c\x5cu:p:q@0a~b:a/...?a`b");
    expect_no("ws:a%2Fb:65536/x{y}z?#a{b}");
    expect_no("http://a^b@429496729608:-1/x`y?%41");
    expect_no("https://[::1.2.3.4]:0x50/?a\x22b#a^b");
    expect_ok("ftp:\x5c\x5ca-b:65534/a//b?%#a`b", "ftp://a-b:65534/a//b?%#a%60b");
    expect_no("wss:\x5c\x5ca\x22b@a,b:0x50/x/./y?a<b#a{b}");
    expect_no("https://127.1:65536/x{y}z?#a b");
    expect_no("HTTP://1.0x2.3.4:0x50/x#y?#%");
    expect_no("WS://a'b@1.02.3.40177.0.0.1:+80/...?a|b");
    expect_no("http://a%2Fb:65536/x{y}z?a\x22b#a<b");
    expect_ok("https://///x#y/x/?a^b#x", "https://x/#y/x/?a^b#x");
    expect_ok("https:\x5cu@a'b:21/a/./b/../c/./d?a=b&c=d#%", "https://u@a'b:21/a/c/d?a=b&c=d#%");
    expect_no("ws:////a~b@65536:99999999999#a<b");
    expect_ok("ws:\x5c\x5c0x/a/b/../../c?a<b#a b", "ws://0.0.0.0/c?a%3Cb#a%20b");
    expect_ok("FTP://a^b@.:80/x#y?a`b#a{b}", "ftp://a%5Eb@.:80/x#y?a%60b#a{b}");
    expect_no("https:\x5c1.02.3.4:65536/x\x22y?a\x5cb#a|b");
    expect_no("https://@65536a%zzb:65535/x/?");
    expect_no("ftp://///x^y/x/./y?%#");
    expect_no("https://u%20v@08:0x50/...?a\x22b#x");
    expect_no("https:/@.:-1//?a\x22b#a^b");
    expect_no("ftp:\x5c\x5c1.2.3.4.:-1/x/./y?a b#a|b");
    expect_no("ws:\x5c\x5ca|b@1.0x2.3.4:65536/a/b/../../c?a=b&c=d#a{b}");
    expect_ok("WSS://a~b@999/a//b?#a\x22b", "wss://a~b@0.0.3.231/a//b?#a%22b");
    expect_no("ftp://a'b@XN--A.COM:80/a/b/../../c#a`b");
    expect_ok("ws:[::ffff:0:1.2.3.4]:443/%2e%2e%2e/x#a|b", "ws://[::ffff:0:102:304]:443/%2e%2e%2e/x#a|b");
    expect_ok("http://[::1.2.3.4]:65535/x?%#%", "http://[::102:304]:65535/x?%#%");
}
